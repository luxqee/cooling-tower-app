# Neon Postgres (Phase 1a)
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# Clerk Authentication (Phase 1a)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Vercel Blob Storage (Phase 1c)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Web Push / VAPID (Phase 1c) - generate with: node -e "require('web-push').generateVAPIDKeys()"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BH...
VAPID_PRIVATE_KEY=...
VAPID_CONTACT_EMAIL=dev@example.com

# AI features (Phase 3 batches g/h/i)
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ASSEMBLYAI_API_KEY=xxx
VOYAGE_API_KEY=pa-xxx

# Voice Notes (Phase 3 batch h) — shared secret AssemblyAI echoes back in its
# webhook callback header so we can verify the request actually came from them.
# Generate with: openssl rand -hex 24
ASSEMBLYAI_WEBHOOK_SECRET=xxx

# Rate limiting (optional) — checkRateLimit() in src/lib/rateLimit.ts is
# inert (always allows) unless BOTH of these are set. Get them from an
# Upstash Redis database (upstash.com).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Error monitoring — Sentry is active (see sentry.server.config.ts,
# sentry.edge.config.ts, src/instrumentation-client.ts). SENTRY_AUTH_TOKEN/
# ORG/PROJECT are only needed for build-time source map upload (sentry.io).
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_ORG=xxx
SENTRY_PROJECT=xxx
SENTRY_AUTH_TOKEN=xxx
