# Copy to .env.test.local and fill in real values
# Used by Playwright E2E tests and pnpm seed:test

# Neon test branch — create at console.neon.tech → Branches → Create Branch → "test"
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# Same Clerk keys as dev — test users live in your Clerk dev env
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Blob and VAPID (same as dev for testing)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BH...
VAPID_PRIVATE_KEY=...
VAPID_CONTACT_EMAIL=dev@example.com

# Test user credentials — create these in Clerk Dashboard
# Give them public_metadata: { "role": "technician" } / { "role": "director" }
TEST_TECHNICIAN_EMAIL=technician@dev.example.com
TEST_TECHNICIAN_PASSWORD=DevTest123!
TEST_DIRECTOR_EMAIL=director@dev.example.com
TEST_DIRECTOR_PASSWORD=DevTest123!

# Clerk user IDs for the above (find in Clerk Dashboard → Users → click user → copy ID)
TEST_TECHNICIAN_CLERK_ID=user_xxx
TEST_DIRECTOR_CLERK_ID=user_yyy
SEED_TECHNICIAN_CLERK_ID=user_xxx
SEED_DIRECTOR_CLERK_ID=user_yyy

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3000
